{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeadlessMc",
  "version": "1.0.0",
  "identifier": "io.github.headlesshq.web",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A launcher for Minecraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/quarkus-backend"
    ]
  }
}
